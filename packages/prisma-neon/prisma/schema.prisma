generator client {
  provider = "prisma-client"
  output   = "../generated"
}

datasource db {
  provider     = "postgresql"
  relationMode = "prisma"
}

model Source {
  id         String       @id @default(uuid()) @db.Uuid
  ownerId    String       @default(dbgenerated("auth.uid()")) @db.Uuid
  type       SourceType
  title      String?
  url        String?
  filename   String?
  sha256     String?      @unique
  createdAt  DateTime     @default(now()) @db.Timestamptz(6)
  texts      SourceText[]
  notes      Note?
  flashcards Flashcard[]
  quizzes    Quiz[]
  threads    ChatThread[]

  @@index([ownerId])
  @@index([type])
}

model SourceText {
  id         String         @id @default(uuid()) @db.Uuid
  ownerId    String         @default(dbgenerated("auth.uid()")) @db.Uuid
  sourceId   String         @db.Uuid
  ordinal    Int
  pageNumber Int?
  startSec   Int?
  endSec     Int?
  text       String
  createdAt  DateTime       @default(now()) @db.Timestamptz(6)
  source     Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  flashcards Flashcard[]
  questions  QuizQuestion[]

  @@unique([sourceId, ordinal])
  @@index([sourceId])
  @@index([ownerId])
}

model Note {
  id        String   @id @default(uuid()) @db.Uuid
  ownerId   String   @default(dbgenerated("auth.uid()")) @db.Uuid
  sourceId  String   @unique @db.Uuid
  model     String?
  summaryMd String
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  title     String?
  source    Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model Flashcard {
  id           String      @id @default(uuid()) @db.Uuid
  ownerId      String      @default(dbgenerated("auth.uid()")) @db.Uuid
  sourceId     String      @db.Uuid
  front        String
  back         String
  sourceTextId String?     @db.Uuid
  createdAt    DateTime    @default(now()) @db.Timestamptz(6)
  source       Source      @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  sourceText   SourceText? @relation(fields: [sourceTextId], references: [id], onDelete: SetNull)

  @@index([sourceId])
  @@index([sourceTextId])
  @@index([ownerId])
}

model Quiz {
  id        String         @id @default(uuid()) @db.Uuid
  ownerId   String         @default(dbgenerated("auth.uid()")) @db.Uuid
  sourceId  String         @db.Uuid
  title     String
  createdAt DateTime       @default(now()) @db.Timestamptz(6)
  source    Source         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]

  @@index([sourceId])
  @@index([ownerId])
}

model QuizQuestion {
  id           String      @id @default(uuid()) @db.Uuid
  ownerId      String      @default(dbgenerated("auth.uid()")) @db.Uuid
  quizId       String      @db.Uuid
  prompt       String
  choices      Json
  correctIndex Int
  explanation  String?
  sourceTextId String?     @db.Uuid
  quiz         Quiz        @relation(fields: [quizId], references: [id], onDelete: Cascade)
  sourceText   SourceText? @relation(fields: [sourceTextId], references: [id], onDelete: SetNull)

  @@index([quizId])
  @@index([sourceTextId])
  @@index([ownerId])
}

model ChatThread {
  id        String        @id @default(uuid()) @db.Uuid
  ownerId   String        @default(dbgenerated("auth.uid()")) @db.Uuid
  sourceId  String        @db.Uuid
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  source    Source        @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]

  @@index([sourceId])
  @@index([ownerId])
}

model ChatMessage {
  id        String     @id @default(uuid()) @db.Uuid
  ownerId   String     @default(dbgenerated("auth.uid()")) @db.Uuid
  threadId  String     @db.Uuid
  role      ChatRole
  content   String
  citations Json?
  createdAt DateTime   @default(now()) @db.Timestamptz(6)
  thread    ChatThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, createdAt])
  @@index([ownerId])
}

model chunk {
  id        String                 @id(map: "chunk_pkey1") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  text      String?
  metadata  Json?
  embedding Unsupported("vector")?
}

enum SourceType {
  pdf
  web
  youtube
  text
}

enum ChatRole {
  user
  assistant
  system
}
